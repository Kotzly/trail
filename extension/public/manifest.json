{
  "manifest_version": 3,
  "name": "trail",
  "description": "transform your browsing experience. trail enables you to track your browsing sessions as trees",
  "version": "1.0.0",
  "icons": {
    "16": "icons/trail-16.png",
    "32": "icons/trail-32.png",
    "48": "icons/trail-48.png",
    "128": "icons/trail-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "open trail",
    "default_icon": {
      "16": "icons/trail-16.png",
      "32": "icons/trail-32.png",
      "48": "icons/trail-48.png"
    }
  }
}
