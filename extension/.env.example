# Trail Extension — environment variables
# Copy to .env.local (gitignored) and fill in. Prefixed vars are exposed to the
# extension bundle via Vite/WXT define.

# Supabase — prod project
WXT_SUPABASE_URL=https://tevskvkyhenzqxkcgbbm.supabase.co
WXT_SUPABASE_ANON_KEY=

# Google OAuth is configured inside Supabase Dashboard → Authentication →
# Providers → Google. The extension never sees the client_id or secret —
# the OAuth flow is mediated by Supabase via
#   chrome.identity.launchWebAuthFlow({ url: supabase authorize URL })
# which redirects to https://<ext-id>.chromiumapp.org/ (intercepted by
# chrome.identity). Add that redirect URL to Supabase → URL Configuration.

# Observability
WXT_SENTRY_DSN=
WXT_POSTHOG_KEY=
WXT_POSTHOG_HOST=https://eu.i.posthog.com

# Build channel: "stable" | "beta" — gates experimental features
WXT_RELEASE_CHANNEL=stable
