{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@entrypoints/*": ["src/entrypoints/*"],
      "@apps/*": ["src/apps/*"],
      "@ui/*": ["src/ui/*"],
      "@features/*": ["src/features/*"],
      "@background/*": ["src/background/*"],
      "@content/*": ["src/content/*"],
      "@shared/*": ["src/shared/*"]
    },
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // exactOptionalPropertyTypes conflicts with shadcn/Radix component prop patterns
    // (optional props passed through spread end up as `T | undefined` where target expects `T`).
    // Trade: we lose the strict distinction between "prop omitted" vs "prop explicitly undefined".
    // All other `strict` flags are on, so real type safety is preserved.
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
