{
  "name": "trail",
  "version": "1.0.0",
  "description": "Trail is a browser extension for Chrome/Brave that visualizes your browsing history as an interactive navigation tree. Instead of a linear history, Trail shows how you actually browse - with branches, forks, and parallel explorations.",
  "main": "service-worker.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "wxt",
    "dev:local": "pnpm run backend:local && wxt",
    "dev:gettrail": "pnpm run backend:gettrail && wxt",
    "build": "wxt build",
    "build:local": "pnpm run backend:local && wxt build",
    "build:gettrail": "pnpm run backend:gettrail && wxt build",
    "zip": "wxt zip",
    "backend:status": "node scripts/backend-preset.mjs status",
    "backend:local": "node scripts/backend-preset.mjs local",
    "backend:gettrail": "node scripts/backend-preset.mjs gettrail",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "generate-icons": "tsx src/shared/utils/generate-icons.ts",
    "test": "node --import tsx tests/basic.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.32",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.2",
    "lucide": "^0.562.0",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shard": "^1.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.12",
    "wxt": "^0.20.17",
    "zustand": "^4.5.5"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.5",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "minisearch": "^7.2.0",
    "motion": "^12.30.1",
    "pixi.js": "^8.8.2",
    "postcss": "^8.5.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  }
}
