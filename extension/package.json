{
  "name": "Trail",
  "version": "0.9.1",
  "description": "Your browser sessions, visualized.",
  "main": "service-worker.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "wxt",
    "dev:local": "pnpm run backend:local && wxt",
    "dev:gettrail": "pnpm run backend:gettrail && wxt",
    "build": "wxt build",
    "build:local": "pnpm run backend:local && wxt build",
    "build:gettrail": "pnpm run backend:gettrail && wxt build",
    "zip": "wxt zip",
    "backend:status": "node scripts/backend-preset.mjs status",
    "backend:local": "node scripts/backend-preset.mjs local",
    "backend:gettrail": "node scripts/backend-preset.mjs gettrail",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "generate-icons": "tsx src/shared/utils/generate-icons.ts",
    "test": "node --import tsx tests/basic.test.ts && node --import tsx tests/architecture-boundaries.test.ts && node --import tsx tests/spotlight-search.test.ts"
  },
  "keywords": [],
  "author": "Trail",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "lucide": "^0.575.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shard": "^1.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wxt": "^0.20.18",
    "zustand": "^5.0.11"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.5",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "minisearch": "^7.2.0",
    "motion": "^12.34.3",
    "pixi.js": "^8.16.0",
    "postcss": "^8.5.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6"
  }
}
