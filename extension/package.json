{
  "name": "Trail",
  "version": "1.0.0",
  "description": "Your browser sessions, visualized.",
  "main": "service-worker.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "wxt",
    "preview:ui": "vite --config vite.preview.config.ts",
    "dev:local": "pnpm run backend:local && wxt",
    "dev:gettrail": "pnpm run backend:gettrail && wxt",
    "build": "wxt build",
    "build:local": "pnpm run backend:local && wxt build",
    "build:gettrail": "pnpm run backend:gettrail && wxt build",
    "zip": "wxt zip",
    "backend:status": "node scripts/backend-preset.mjs status",
    "backend:local": "node scripts/backend-preset.mjs local",
    "backend:gettrail": "node scripts/backend-preset.mjs gettrail",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "generate-icons": "tsx src/shared/utils/generate-icons.ts",
    "test": "node --import tsx tests/basic.test.ts && node --import tsx tests/architecture-boundaries.test.ts && node --import tsx tests/transport-contracts.test.ts && node --import tsx tests/content-bridge-runtime.test.ts && node --import tsx tests/graph-layout.test.ts && node --import tsx tests/fold-chains.test.ts && node --import tsx tests/url-pattern.test.ts && node --import tsx tests/layout-precompute-regression.test.ts && node --import tsx tests/root-invariant.test.ts && node --import tsx tests/smoke-e2e.test.ts && node --import tsx tests/ui-interaction.test.ts && node --import tsx tests/tree-diff.test.ts && node --import tsx tests/conflict-merge.integration.test.ts && node --import tsx tests/delete-flow.test.ts",
    "e2e": "pnpm run build && playwright test",
    "e2e:ui": "pnpm run build && playwright test --ui"
  },
  "keywords": [],
  "author": "Trail",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@wxt-dev/i18n": "^0.2.5",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "wxt": "^0.20.18",
    "zustand": "^5.0.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/browser": "^10.49.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-virtual": "^3.13.24",
    "@webext-core/messaging": "^2.3.0",
    "@webext-core/proxy-service": "^2.0.0",
    "@xyflow/react": "^12.10.2",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "^1.45.1",
    "fflate": "^0.8.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "minisearch": "^7.2.0",
    "motion": "^12.34.3",
    "next-themes": "^0.4.6",
    "p-debounce": "^5.1.0",
    "posthog-js-lite": "^4.6.10",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tinykeys": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  }
}
