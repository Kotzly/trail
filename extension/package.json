{
  "name": "Trail",
  "version": "0.9.1",
  "description": "Your browser sessions, visualized.",
  "main": "service-worker.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "wxt",
    "dev:local": "pnpm run backend:local && wxt",
    "dev:gettrail": "pnpm run backend:gettrail && wxt",
    "build": "wxt build",
    "build:local": "pnpm run backend:local && wxt build",
    "build:gettrail": "pnpm run backend:gettrail && wxt build",
    "zip": "wxt zip",
    "backend:status": "node scripts/backend-preset.mjs status",
    "backend:local": "node scripts/backend-preset.mjs local",
    "backend:gettrail": "node scripts/backend-preset.mjs gettrail",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,json}'",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "generate-icons": "tsx src/shared/utils/generate-icons.ts",
    "test": "node --import tsx tests/basic.test.ts && node --import tsx tests/architecture-boundaries.test.ts && node --import tsx tests/spotlight-search.test.ts && node --import tsx tests/rpc-schema.test.ts && node --import tsx tests/layout-signature.test.ts && node --import tsx tests/smoke-e2e.test.ts && node --import tsx tests/ui-interaction.test.ts"
  },
  "keywords": [],
  "author": "Trail",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lucide": "^0.575.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shard": "^1.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "wxt": "^0.20.18",
    "zustand": "^5.0.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-virtual": "^3.13.22",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "elkjs": "^0.11.1",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.2",
    "input-otp": "^1.4.2",
    "minisearch": "^7.2.0",
    "motion": "^12.34.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.9.0",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  }
}
