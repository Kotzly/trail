{
  "name": "trail",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "sh -c 'pnpm -r --parallel --filter \"!./apps/video\" dev & pnpm --dir extension dev:local; wait'",
    "dev:web": "pnpm -r --parallel --filter '!./apps/video' dev",
    "dev:extension": "pnpm --dir extension dev:local",
    "dev:marketing": "pnpm --filter @trail/marketing dev",
    "dev:account": "pnpm --filter @trail/account dev",
    "build": "pnpm -r --filter '!./apps/video' build",
    "lint": "pnpm -r --filter '!./apps/video' lint",
    "test": "pnpm -r --filter '!./apps/video' test",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "typecheck": "pnpm -r --filter '!./apps/video' typecheck",
    "format": "pnpm -r --filter '!./apps/video' format",
    "db:migrate": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --project-id tevskvkyhenzqxkcgbbm > packages/db/src/generated/database.types.ts",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "cypress": "^15.11.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next": "16.1.6",
    "supabase": "^2.84.5"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1"
  }
}
