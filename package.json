{
  "name": "trail",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "sh -c 'pnpm -r --parallel --filter \"!./apps/video\" dev & pnpm --dir extension dev:local; wait'",
    "dev:web": "pnpm -r --parallel --filter '!./apps/video' dev",
    "dev:extension": "pnpm --dir extension dev:local",
    "dev:marketing": "pnpm --filter @trail/marketing dev",
    "dev:account": "pnpm --filter @trail/account dev",
    "build": "pnpm run db:generate && pnpm -r --filter '!./apps/video' build",
    "lint": "pnpm -r --filter '!./apps/video' lint",
    "test": "pnpm -r --filter '!./apps/video' test",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "typecheck": "pnpm -r --filter '!./apps/video' typecheck",
    "format": "pnpm -r --filter '!./apps/video' format",
    "db:generate": "pnpm --filter @trail/db prisma generate",
    "db:migrate": "pnpm --filter @trail/db prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @trail/db prisma migrate deploy",
    "db:studio": "pnpm --filter @trail/db prisma studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "cypress",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "cypress": "^15.11.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "next": "16.1.6"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1"
  }
}
