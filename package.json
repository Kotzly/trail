{
  "name": "trail",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "sh -c 'pnpm -r --parallel dev & pnpm --dir extension dev:local; wait'",
    "dev:web": "pnpm -r --parallel dev",
    "dev:extension": "pnpm --dir extension dev:local",
    "dev:marketing": "pnpm --filter @trail/marketing dev",
    "dev:account": "pnpm --filter @trail/account dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist extension/node_modules extension/.wxt extension/.output packages/*/node_modules packages/*/dist",
    "db:migrate": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --project-id tevskvkyhenzqxkcgbbm > packages/db/src/generated/database.types.ts",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "picomatch": ">=4.0.4",
      "follow-redirects": ">=1.16.0",
      "postcss": ">=8.5.10"
    }
  },
  "devDependencies": {
    "cypress": "^15.11.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next": "16.2.3",
    "supabase": "^2.84.5"
  },
  "dependencies": {}
}
