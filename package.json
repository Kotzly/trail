{
  "name": "trail",
  "version": "1.0.0",
  "description": "Trail is a browser extension for Chrome/Brave that visualizes your browsing history as an interactive navigation tree. Instead of a linear history, Trail shows how you actually browse - with branches, forks, and parallel explorations.",
  "main": "service-worker.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "tsc && vite build && node scripts/build-extension.js",
    "watch": "tsc --watch",
    "dev": "tsc --watch",
    "dev:ui": "vite",
    "generate-icons": "tsx src/shared/utils/generate-icons.ts",
    "test": "node --import tsx tests/basic.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shard": "^1.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.12",
    "zustand": "^4.5.5"
  }
}
