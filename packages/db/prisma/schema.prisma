generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(cuid())
  email                    String
  name                     String
  emailVerified            Boolean                   @default(false)
  image                    String?
  imageUrl                 String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  onboardingSeenAt         DateTime?
  extensionAuthRevokedAt   DateTime?
  sessions                 Session[]
  accounts                 Account[]
  subscription             UserSubscription?
  billingCheckoutSessions  BillingCheckoutSession[]
  wishlistLeads            WishlistLead[]
  devices                  Device[]
  deviceSessions           DeviceSession[]
  accountSettings          AccountSettings?
  portalSessions           PortalSession[]
  authBridgeCodes          AuthBridgeCode[]
  extensionLoginCodes      ExtensionLoginCode[]
  extensionConnectSessions ExtensionConnectSession[]
  trails                   Trail[]

  @@unique([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
}

model AuthBridgeCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jwt       String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model ExtensionLoginCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
  @@index([userId])
}

enum SubscriptionPlan {
  FREE
  PRO
  TEAMS
}

enum SubscriptionInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  UNKNOWN
}

enum PolarWebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum WishlistLeadSource {
  MARKETING
  ACCOUNT
  EXTENSION
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum DeviceSessionTtlDays {
  DAYS_7
  DAYS_30
  DAYS_90
  DAYS_180
  DAYS_365
}

enum TrailLabelSource {
  USER
  AUTO
  SYSTEM
}

enum BillingProvider {
  MANUAL
  NOWPAYMENTS
}

model UserSubscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                SubscriptionPlan   @default(FREE)
  status              SubscriptionStatus @default(UNKNOWN)
  interval            SubscriptionInterval @default(MONTH)
  pendingInterval     SubscriptionInterval?
  polarCustomerId     String?            @unique
  polarSubscriptionId String?            @unique
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  canceledAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model BillingCheckoutSession {
  id                    String          @id @default(cuid())
  provider              BillingProvider
  orderId               String          @unique
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String
  interval              String
  requestedInterval     String?
  currency              String
  amountCents           Int
  status                String          @default("CREATED")
  paymentStatus         String?
  nowpaymentsInvoiceUrl String?
  nowpaymentsPaymentId  String?
  lastPayload           Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId])
}

model PolarWebhookEvent {
  id          String                  @id
  type        String
  payload     Json
  status      PolarWebhookEventStatus @default(PENDING)
  receivedAt  DateTime                @default(now())
  processedAt DateTime?
  error       String?
  updatedAt   DateTime                @updatedAt
}

model WishlistLead {
  id          String               @id @default(cuid())
  email       String               @unique
  userId      String?
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  sources     WishlistLeadSource[]
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String?
  pagePath    String?
  userAgent   String?
  ip          String?
  country     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Device {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           DeviceStatus    @default(ACTIVE)
  deviceName       String?
  os               String?
  locale           String?
  timezone         String?
  browserName      String?
  browserVersion   String?
  extensionVersion String?
  lastSeenAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         DeviceSession[]
  trails           Trail[]
}

model DeviceSession {
  id         String    @id @default(cuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
}

model AccountSettings {
  userId               String               @id
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSessionTtlDays DeviceSessionTtlDays @default(DAYS_30)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model PortalSession {
  id                      String    @id @default(cuid())
  source                  String?
  locale                  String?
  returnUrl               String?
  userId                  String?
  user                    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  extensionToken          String?
  extensionTokenExpiresAt DateTime?
  approvedAt              DateTime?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([expiresAt])
}

model ExtensionConnectSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([expiresAt])
  @@index([userId])
}

model Trail {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String
  device         Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  label          String
  labelSource    TrailLabelSource @default(USER)
  labelUpdatedAt DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  savedAt        DateTime
  nodeCount      Int
  rootUrl        String?
  rootTitle      String?
  rootFavicon    String?
  payload        Json
  deletedAt      DateTime?

  @@index([userId, deletedAt, updatedAt, id])
  @@index([userId, updatedAt])
}
