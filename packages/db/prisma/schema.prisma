generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(cuid())
  auth0Id         String            @unique
  email           String?
  name            String?
  imageUrl        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  subscription    UserSubscription?
  wishlistLeads   WishlistLead[]
  devices         Device[]
  deviceSessions  DeviceSession[]
  accountSettings AccountSettings?
  portalSessions  PortalSession[]
  trails          Trail[]
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  UNKNOWN
}

enum PolarWebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum WishlistLeadSource {
  MARKETING
  ACCOUNT
  EXTENSION
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum DeviceSessionTtlDays {
  DAYS_7
  DAYS_30
  DAYS_90
  DAYS_180
  DAYS_365
}

enum TrailLabelSource {
  USER
  AUTO
  SYSTEM
}

model UserSubscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(UNKNOWN)
  polarCustomerId    String?            @unique
  polarSubscriptionId String?           @unique
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model PolarWebhookEvent {
  id         String                  @id
  type       String
  payload    Json
  status     PolarWebhookEventStatus @default(PENDING)
  receivedAt DateTime                @default(now())
  processedAt DateTime?
  error      String?
  updatedAt  DateTime                @updatedAt
}

model WishlistLead {
  id          String              @id @default(cuid())
  email       String              @unique
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  sources     WishlistLeadSource[]
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String?
  pagePath    String?
  userAgent   String?
  ip          String?
  country     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Device {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           DeviceStatus   @default(ACTIVE)
  deviceName       String?
  os               String?
  locale           String?
  timezone         String?
  browserName      String?
  browserVersion   String?
  extensionVersion String?
  lastSeenAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         DeviceSession[]
  trails           Trail[]
}

model DeviceSession {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
}

model AccountSettings {
  userId                String               @id
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSessionTtlDays  DeviceSessionTtlDays @default(DAYS_30)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model PortalSession {
  id                       String   @id @default(cuid())
  source                   String?
  locale                   String?
  returnUrl                String?
  userId                   String?
  user                     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  extensionToken           String?
  extensionTokenExpiresAt  DateTime?
  approvedAt               DateTime?
  expiresAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([expiresAt])
}

model Trail {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String
  device         Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  label          String
  labelSource    TrailLabelSource @default(USER)
  labelUpdatedAt DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  savedAt        DateTime
  nodeCount      Int
  rootUrl        String?
  rootTitle      String?
  rootFavicon    String?
  payload        Json
  deletedAt      DateTime?
}
