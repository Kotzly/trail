ENV=development
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://trail:trail@localhost:5432/trail?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORTAL_BASE_URL=http://localhost:5173

BILLING_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_PROVIDER=stub
EMAIL_FROM=no-reply@trail.app
EMAIL_FROM_NAME=Trail
EMAIL_CODE_TTL=10m
EMAIL_CODE_LENGTH=6
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
