NEXT_PUBLIC_APP_URL=https://app.gettrail.net
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Telegram feedback bot (set token + group, then call POST /api/telegram/setup to get topic IDs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_FEATURE_TOPIC_ID=
TELEGRAM_FEEDBACK_TOPIC_ID=
TELEGRAM_SUPPORT_TOPIC_ID=

# Resend newsletter (footer email capture → global Contacts for product-update broadcasts)
# Create API key at https://resend.com/api-keys with "Full access" permission
# (Sending access is NOT enough — Contacts API requires Full access)
# Contacts are global in Resend's new model — no audience/segment ID needed.
RESEND_API_KEY=
