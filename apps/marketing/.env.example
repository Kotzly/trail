# Account/dashboard host (kept until apps/account retires). Deprecated
# in the planned roll-out — the extension owns the account UI and
# marketing absorbs the only remaining auth touchpoint, the
# password-reset page at gettrail.net/auth/reset-password.
NEXT_PUBLIC_APP_URL=https://app.gettrail.net

# Supabase — required for the shared-trail viewer (gettrail.net/s/<code>)
# and the password-reset page (gettrail.net/auth/reset-password).
NEXT_PUBLIC_SUPABASE_URL=https://tevskvkyhenzqxkcgbbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature flag for the share-import button on /s/<code>. Set to
# "true" once the extension build with the bridge handler reaches CWS
# stable. Off by default so old marketing deploys don't render an
# Import button that points at extensions without IMPORT_SHARED_TRAIL.
NEXT_PUBLIC_SHARE_IMPORT_ENABLED=false

SANITY_PROJECT_ID=
SANITY_DATASET=production

# Telegram feedback bot (set token + group, then call POST /api/telegram/setup to get topic IDs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_FEATURE_TOPIC_ID=
TELEGRAM_FEEDBACK_TOPIC_ID=
TELEGRAM_SUPPORT_TOPIC_ID=

# Resend newsletter (footer email capture → global Contacts for product-update broadcasts)
# Create API key at https://resend.com/api-keys with "Full access" permission
# (Sending access is NOT enough — Contacts API requires Full access)
# Contacts are global in Resend's new model — no audience/segment ID needed.
RESEND_API_KEY=
