# Required for Prisma CLI (generate/validate/migrate)
# Local (Docker):  postgresql://postgres:postgres@localhost:5431/trail?schema=public
# Neon:            postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5431/trail?schema=public

BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRAIL_EXTENSION_JWT_SECRET=
BILLING_PROVIDER=manual
BILLING_TEST_MODE=1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE_URL=

# OAuth: comma-separated list of allowed *.chromiumapp.org hostnames for
# Chrome extension identity API callbacks. In production, set to the actual
# CWS extension host (e.g., "abcdefghijklmnop.chromiumapp.org").
# In development, trail-dev.chromiumapp.org is included automatically.
OAUTH_ALLOWED_EXTENSION_HOSTS=
