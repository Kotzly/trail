# Trail Account App — environment variables
# Copy to .env.local (gitignored) and fill in. Values without obvious defaults
# come from the Supabase Dashboard (https://supabase.com/dashboard/project/tevskvkyhenzqxkcgbbm).

# --- Supabase (required) ---
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://tevskvkyhenzqxkcgbbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Dashboard → Project Settings → API → service_role key. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (build-time only, used by Next route compilation) ---
# Hosted Supabase pooler URL. Dashboard → Project Settings → Database → Connection string → Pooler.
DATABASE_URL=

# --- Extension token signing (required) ---
# Random 32+ byte secret used to sign device-scoped JWTs. Generate with:
#   openssl rand -base64 48
TRAIL_EXTENSION_JWT_SECRET=

# --- OAuth (two separate allowlists; both required in prod) ---
# 1) Comma-separated Chrome extension IDs (CORS allowlist for /api/v1/* requests
#    originating from chrome-extension://<id>). Dev extension ID: see
#    extension/wxt.config.ts. Prod ID: from Chrome Web Store listing.
OAUTH_ALLOWED_EXTENSION_IDS=
# 2) Comma-separated *.chromiumapp.org hostnames (OAuth identity-API redirect
#    targets). Dev host "trail-dev.chromiumapp.org" is included automatically
#    when NODE_ENV != "production". Set to actual CWS extension host(s) in prod,
#    e.g. "abcdefghijklmnop.chromiumapp.org".
OAUTH_ALLOWED_EXTENSION_HOSTS=

# --- Billing ---
BILLING_PROVIDER=manual
BILLING_TEST_MODE=1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE_URL=
